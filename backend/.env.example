#copy this file to backend/.env and change values if needed
#never commit .env or the google key file

#port the server runs on
PORT=3000
#development shows error details in responses, production hides them
NODE_ENV=development
#which origins may call the api, * allows any (fine for expo go and ngrok)
CORS_ORIGIN=*
#biggest photo accepted, in megabytes
MAX_IMAGE_MB=10

#ocr settings (manaal)
#path to the google service account key (the secrets folder is gitignored)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-key.json
#cloud_vision (falls back to tesseract if it fails) or tesseract
OCR_PRIMARY=cloud_vision

FACT_CHECK_API_KEY=

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=facttrace